<Window x:Class="Inventar.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Инвентаризация" Height="790" Width="1240" MinHeight="650" MinWidth="980"
 WindowStartupLocation="CenterScreen" Background="#F3F6FB"
 PreviewKeyDown="Window_PreviewKeyDown">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#173758" Padding="22,15">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="ИНВЕНТАРИЗАЦИЯ" Foreground="White" FontSize="21" FontWeight="Bold"/>
     <TextBlock Text="Учёт фактических остатков · сравнение с документом" Foreground="#C6D2E5" Margin="0,4,0,0"/></StackPanel>
    <TextBlock x:Name="FileLabel" Grid.Column="1" Text="Файл не выбран" Foreground="#C6D2E5" VerticalAlignment="Center"/>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Top" Padding="16,12">
   <WrapPanel>
    <Button Content="＋ Загрузить Excel" Click="Load_Click" Padding="14,8" Margin="0,0,8,0"/>
    <Button Content="↶ Отменить скан" Click="Undo_Click" Padding="14,8" Margin="0,0,8,0"/>
    <Button Content="Итоги" Click="Finish_Click" Padding="14,8" Margin="0,0,8,0"/>
    <Button Content="Экспорт CSV" Click="Export_Click" Padding="14,8" Margin="0,0,8,0"/>
    <Button x:Name="SoundButton" Content="🔊 Звук: Вкл" Click="Sound_Click" Padding="14,8"/>
   </WrapPanel>
  </Border>
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE3EE" BorderThickness="1" Margin="16,0,16,12" Padding="14">
   <StackPanel><TextBlock Text="СКАНИРОВАНИЕ ШТРИХКОДА / АРТИКУЛА" Foreground="#68758A" FontWeight="SemiBold"/>
    <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Добавить" Click="Scan_Click" Padding="18,8" Margin="10,0,0,0"/>
     <TextBox x:Name="ScanBox" FontSize="17" Padding="8" VerticalContentAlignment="Center" KeyDown="ScanBox_KeyDown"/>
    </DockPanel>
    <TextBlock Text="Сканер должен завершать ввод клавишей Enter." Foreground="#68758A" FontSize="11" Margin="0,6,0,0"/>
   </StackPanel>
  </Border>
  <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="16,0,8,12">
   <Border Background="White" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="ПОЗИЦИЙ" Foreground="#68758A"/><TextBlock x:Name="TotalText" Text="0" FontSize="23" FontWeight="Bold"/></StackPanel></Border>
   <Border Background="White" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="СОВПАДАЕТ" Foreground="#68758A"/><TextBlock x:Name="MatchText" Text="0" FontSize="23" Foreground="#16865B" FontWeight="Bold"/></StackPanel></Border>
   <Border Background="White" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="НЕДОСТАЧА" Foreground="#68758A"/><TextBlock x:Name="ShortText" Text="0" FontSize="23" Foreground="#C43D4B" FontWeight="Bold"/></StackPanel></Border>
   <Border Background="White" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="ИЗЛИШЕК" Foreground="#68758A"/><TextBlock x:Name="OverText" Text="0" FontSize="23" Foreground="#C17A16" FontWeight="Bold"/></StackPanel></Border>
   <Border Background="White" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="ОТСКАНИРОВАНО" Foreground="#68758A"/><TextBlock x:Name="ScannedText" Text="0" FontSize="23" Foreground="#2864DC" FontWeight="Bold"/></StackPanel></Border>
  </UniformGrid>
  <Border DockPanel.Dock="Top" Margin="16,0,16,8">
   <DockPanel><TextBlock Text="Список товаров" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
    <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="300" Padding="7" TextChanged="Search_Changed"/>
    <TextBlock Text="Поиск:" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
   </DockPanel>
  </Border>
  <DataGrid x:Name="ItemsGrid" Margin="16,0,16,8" AutoGenerateColumns="False" IsReadOnly="True"
   CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
   AlternatingRowBackground="#F8FAFD" SelectionMode="Single">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Артикул" Binding="{Binding Code}" Width="140"/>
    <DataGridTextColumn Header="Номенклатура" Binding="{Binding Name}" Width="*"/>
    <DataGridTextColumn Header="Остаток (N)" Binding="{Binding Stock}" Width="120"/>
    <DataGridTextColumn Header="Факт" Binding="{Binding Fact}" Width="90"/>
    <DataGridTextColumn Header="Разница" Binding="{Binding Diff}" Width="100"/>
    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="130"/>
   </DataGrid.Columns>
  </DataGrid>
  <StatusBar DockPanel.Dock="Bottom"><StatusBarItem><TextBlock x:Name="StatusText" Text="Загрузите Excel-файл инвентаризации"/></StatusBarItem><StatusBarItem HorizontalAlignment="Right"><TextBlock Text="Автосохранение включено" Foreground="#16865B"/></StatusBarItem></StatusBar>
 </DockPanel>
</Window>
